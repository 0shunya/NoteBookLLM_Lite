# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~


