VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_SITE_URL=http://localhost:5173
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GEMINI_KEY_ENCRYPTION_PUBLIC_KEY=

# Created and managed by `npx convex dev`:
# CONVEX_DEPLOYMENT=

# Configure these with `npx convex env set`; never add them to Vite variables:
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# (Legacy SUPABASE_SERVICE_ROLE_KEY is also supported.)
# SUPABASE_STORAGE_BUCKET=documents

# Optional Google sign-in. Configure both with `npx convex env set`;
# never put the client secret in a VITE_ variable or browser .env file.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
